@{
    ViewData["Title"] = "Завантаження файлів";
    var files = ViewBag.Files as List<string?> ?? new List<string?>();
}

<div style="max-width: 600px; margin: 30px auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <h1 style="font-size: 28px; font-weight: bold; margin-bottom: 25px; text-align: center;">Завантаження файлів на сервер</h1>

    <div style="background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; padding: 20px; margin-bottom: 25px;">
        <form asp-action="UploadFile" method="post" enctype="multipart/form-data">
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 8px; font-weight: 500;">Виберіть файл для завантаження у wwwroot/Files:</label>
                <input type="file" name="file" required style="display: block; width: 100%; padding: 6px; border: 1px solid #ced4da; border-radius: 4px; background: #fff;" />
            </div>

            <div style="text-align: right;">
                <button type="submit" style="padding: 6px 16px; background-color: #0d6efd; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 15px;">Завантажити файл</button>
            </div>
        </form>

        @if (ViewBag.UploadSuccess != null)
        {
            <div style="margin-top: 15px; padding: 10px; background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc; border-radius: 4px; font-weight: 500;">
                @ViewBag.UploadSuccess
            </div>
        }

        @if (ViewBag.UploadError != null)
        {
            <div style="margin-top: 15px; padding: 10px; background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7; border-radius: 4px;">
                @ViewBag.UploadError
            </div>
        }
    </div>

    <div style="background-color: #ffffff; border: 1px solid #dee2e6; border-radius: 4px; padding: 20px;">
        <h4 style="margin-top: 0; margin-bottom: 15px; font-size: 18px; border-bottom: 1px solid #eee; padding-bottom: 8px;">Список завантажених файлів у wwwroot/Files:</h4>
        @if (files.Count > 0)
        {
            <ul style="margin: 0; padding-left: 20px;">
                @foreach (var f in files)
                {
                    <li style="margin-bottom: 5px;">
                        <a href="~/Files/@f" target="_blank" style="color: #0d6efd; text-decoration: none;">@f</a>
                    </li>
                }
            </ul>
        }
        else
        {
            <p style="color: #6c757d; margin: 0;">Файлів поки що немає.</p>
        }
    </div>
</div>
