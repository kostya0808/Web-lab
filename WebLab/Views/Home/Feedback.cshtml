@model WebLab.Models.FeedbackViewModel
@{
    ViewData["Title"] = "Валідація FluentValidation";
}

<div style="max-width: 600px; margin: 30px auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <h1 style="font-size: 28px; font-weight: bold; margin-bottom: 25px; text-align: center;">Форма перевірки FluentValidation</h1>

    <div style="background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; padding: 25px; margin-bottom: 25px;">
        @if (ViewBag.FeedbackSuccess != null)
        {
            <div style="margin-bottom: 20px; padding: 12px; background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc; border-radius: 4px; font-weight: bold;">
                @ViewBag.FeedbackSuccess
            </div>
        }

        <form asp-action="Feedback" method="post">
            <div asp-validation-summary="ModelOnly" style="color: #dc3545; margin-bottom: 15px; font-weight: 500;"></div>

            <div style="margin-bottom: 15px;">
                <label asp-for="Name" style="display: block; font-weight: 500; margin-bottom: 5px;">Ім'я:</label>
                <input asp-for="Name" style="width: 100%; padding: 6px 10px; border: 1px solid #ced4da; border-radius: 4px;" />
                <span asp-validation-for="Name" style="color: #dc3545; font-size: 13px; display: block; margin-top: 3px;"></span>
            </div>

            <div style="margin-bottom: 15px;">
                <label asp-for="Email" style="display: block; font-weight: 500; margin-bottom: 5px;">Електронна пошта:</label>
                <input asp-for="Email" style="width: 100%; padding: 6px 10px; border: 1px solid #ced4da; border-radius: 4px;" />
                <span asp-validation-for="Email" style="color: #dc3545; font-size: 13px; display: block; margin-top: 3px;"></span>
            </div>

            <div style="margin-bottom: 15px;">
                <label asp-for="Age" style="display: block; font-weight: 500; margin-bottom: 5px;">Вік (від 18 до 100):</label>
                <input asp-for="Age" type="number" style="width: 100%; padding: 6px 10px; border: 1px solid #ced4da; border-radius: 4px;" />
                <span asp-validation-for="Age" style="color: #dc3545; font-size: 13px; display: block; margin-top: 3px;"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="Message" style="display: block; font-weight: 500; margin-bottom: 5px;">Повідомлення:</label>
                <textarea asp-for="Message" rows="3" style="width: 100%; padding: 6px 10px; border: 1px solid #ced4da; border-radius: 4px;"></textarea>
                <span asp-validation-for="Message" style="color: #dc3545; font-size: 13px; display: block; margin-top: 3px;"></span>
            </div>

            <div style="text-align: right;">
                <button type="submit" style="padding: 7px 20px; background-color: #0d6efd; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 15px;">Перевірити валідацію</button>
            </div>
        </form>
    </div>
</div>
