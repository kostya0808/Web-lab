@model WebLab.Models.EmailViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div style="max-width: 600px; margin: 30px auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <div style="background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; padding: 15px; margin-bottom: 25px;">
        <h4 style="margin-top: 0; margin-bottom: 10px; color: #333;">Стан додатку та параметри:</h4>
        <p style="margin: 4px 0;"><strong>Користувач у сесії:</strong> @ViewBag.SessionUser</p>
        <p style="margin: 4px 0;"><strong>Останній візит (Cookie):</strong> @ViewBag.LastVisit</p>
        <p style="margin: 4px 0;"><strong>Поточна локалізація сайту:</strong> @ViewBag.CurrentCulture</p>
        @if (ViewBag.QueryInfo != null)
        {
            <p style="margin: 4px 0; color: #0d6efd;"><strong>Query Info:</strong> @ViewBag.QueryInfo</p>
        }
        <div style="margin-top: 10px;">
            <a href="?user=Студент&info=ТестуванняQuery" style="display: inline-block; padding: 4px 10px; background-color: #e9ecef; border: 1px solid #ced4da; text-decoration: none; color: #212529; border-radius: 3px; font-size: 13px;">Встановити query: ?user=Студент&info=ТестуванняQuery</a>
        </div>
    </div>

    <h1 style="font-size: 28px; font-weight: bold; margin-bottom: 25px; text-align: center;">Відправка повідомлення</h1>

    <form asp-action="SendEmail" method="post">
        <div style="display: flex; align-items: center; justify-content: flex-end; margin-bottom: 15px;">
            <label style="margin-right: 10px; font-size: 16px;">Email отримувача:</label>
            <input type="email" asp-for="Email" required style="width: 260px; padding: 4px 6px; font-size: 15px; border: 1px solid #767676; border-radius: 2px;" />
        </div>

        <div style="display: flex; align-items: flex-start; justify-content: flex-end; margin-bottom: 15px;">
            <label style="margin-right: 10px; font-size: 16px; margin-top: 4px;">Повідомлення:</label>
            <textarea asp-for="Message" required rows="3" style="width: 260px; padding: 4px 6px; font-size: 15px; border: 1px solid #767676; border-radius: 2px;"></textarea>
        </div>

        <div style="text-align: center; margin-top: 20px;">
            <button type="submit" style="padding: 3px 14px; font-size: 15px; border: 1px solid #767676; background-color: #efefef; border-radius: 2px; cursor: pointer;">Submit</button>
        </div>
    </form>

    @if (ViewBag.Success != null)
    {
        <div style="margin-top: 20px; text-align: center; color: #008000; font-size: 24px; font-weight: bold;">
            @ViewBag.Success
        </div>
    }

    <vc:system-stats />
</div>
